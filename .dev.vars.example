# Copy to .dev.vars and fill in project keys from Langfuse Settings > API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use the base URL for your project's region or HTTPS self-hosted instance.
LANGFUSE_BASE_URL=

# Optional exact HTTPS host allowlist for custom calendar webhook adapters.
# INTEGRATION_ALLOWED_HOSTS=booking.example.com

# Optional: authenticated TTSForFree evaluation studio (server-side only)
# TTSFORFREE_API_KEY=register-key-in-cloudflare-secrets
